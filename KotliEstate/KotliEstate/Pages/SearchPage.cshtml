@page
@using Microsoft.AspNetCore.Server.Kestrel.Core
@model KotliEstate.Pages.SearchPage
<div class="container">
    <div class="row g-4 ">
        <h2>
            Search Property
        </h2>
        @if (@ViewData["flag"] == "true")
        {
            @foreach (var SelectProperty in Model.SearchProperty)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="property-item rounded overflow-hidden">
                        <div class="position-relative overflow-hidden">
                            <a href=""><img class="img-fluid" src="uploaded_image/property/@SelectProperty.image" alt=""></a>
                            <div class="bg-primary rounded text-white position-absolute start-0 top-0 m-4 py-1 px-3">@SelectProperty.Category</div>
                            <div class="bg-white rounded-top text-primary position-absolute start-0 bottom-0 mx-4 pt-1 px-3">@SelectProperty.Types_Of_Properties</div>
                        </div>
                        <div class="p-4 pb-0">
                            <h5 class="text-primary mb-3">@SelectProperty.Price</h5>
                            <a class="d-block h5 mb-2" href="">@SelectProperty.Title</a>
                            <p><i class="fa fa-map-marker-alt text-primary me-2"></i>@SelectProperty.Title</p>
                        </div>
                        <div class="d-flex border-top">
                            <small class="flex-fill text-center border-end py-2"><i class="fa fa-ruler-combined text-primary me-2"></i>@SelectProperty.Area Sqft</small>
                            <small class="flex-fill text-center border-end py-2"><i class="fa fa-bed text-primary me-2"></i>@SelectProperty.Number_Of_Bedrooms Bed</small>
                            <small class="flex-fill text-center py-2"><i class="fa fa-bath text-primary me-2"></i>@SelectProperty.Number_Of_Bathrooms Bath</small>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <h2>Not Found</h2>
        }
      
       
    </div>
</div>
