@page
@model KotliEstate.Pages.Admin.Testimonial.CreateModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>testimonial</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
