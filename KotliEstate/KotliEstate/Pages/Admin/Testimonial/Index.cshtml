@page
@model KotliEstate.Pages.Admin.Testimonial.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create" class="btn btn-outline-primary">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.testimonial[0].Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.testimonial[0].Professional)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.testimonial[0].Review)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.testimonial[0].Image)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.testimonial) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Professional)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Review)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Image)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-primary">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-success">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-danger">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
