@page
@model KotliEstate.Pages.Admin.Property.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.property[0].FirstName)
            </th>
           
            <th>
                @Html.DisplayNameFor(model => model.property[0].MobileNumber)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.property[0].Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.property[0].Price)
            </th>
           
            <th>
                @Html.DisplayNameFor(model => model.property[0].Category)
            </th>
           
            <th>
                @Html.DisplayNameFor(model => model.property[0].Types_Of_Properties)
            </th>
          
            <th>
                @Html.DisplayNameFor(model => model.property[0].Status)
            </th>
           
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.property) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.FirstName)
            </td>
           
            <td>
                @Html.DisplayFor(modelItem => item.MobileNumber)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Title)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Price)
            </td>
          
            <td>
                @Html.DisplayFor(modelItem => item.Category)
            </td>
         
            <td>
                @Html.DisplayFor(modelItem => item.Types_Of_Properties)
            </td>
          
            <td>
                @Html.DisplayFor(modelItem => item.Status)
            </td>
          
            <td>
                <a asp-page="./Edit" asp-route-id="@item.id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
