@page
@model KotliEstate.Pages.property_form
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Property Register Form</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #effdf5; /* Light gray background */
        }
        .custom-form {
            background-color:#00B98E; /* White form background */
            border: 1px solid #ddd;
            border-radius: 10px;
            padding: 20px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="row justify-content-start mt-5">
            
            <div class="col-md-6">
                
                <form method="post" enctype="multipart/form-data" class="custom-form">
                    <h2 class="mb-4">Registeration Form</h2>
                    <div class="mb-3"> <img src="img/backpro.jpg" height="320px" width="600px"> <br>
                        <label for="firstName" class="form-label">First Name</label>
                        <input asp-for="myProperty.FirstName" class="form-control" id="firstName" placeholder="Enter first name">
                    </div>
                    <div class="mb-3">
                        <label for="lastName" class="form-label">Last Name</label>
                        <input asp-for="myProperty.LastName" class="form-control" id="lastName" placeholder="Enter last name">
                    </div>
                    <div class="mb-3">
                        <label for="cnic" class="form-label">CNIC</label>
                        <input asp-for="myProperty.CNIC" class="form-control" id="cnic" placeholder="Enter last name">
                    </div>
                    <div class="mb-3">
                        <label for="Mobile" class="form-label">Mobile</label>
                        <input asp-for="myProperty.MobileNumber" class="form-control" id="Mobilenumber" placeholder="Enter last name">
                    </div>
                    <div class="mb-3">
                        <label for="title" class="form-label">Title</label>
                        <input asp-for="myProperty.Title" class="form-control" id="title" placeholder="Enter property title">
                    </div>
                    <div class="mb-3">
                        <label for="price" class="form-label">Price</label>
                        <input asp-for="myProperty.Price" class="form-control" id="price" placeholder="Enter price">
                    </div>
                    <div class="mb-3">
                        <label for="address" class="form-label">Address</label>
                        <textarea asp-for="myProperty.Address" class="form-control" id="address" rows="3" placeholder="Enter address"></textarea>
                    </div>
                    <div class="mb-3">
                        <label asp-for="myProperty.Types_Of_Properties" class="form-label">Type of Property</label>
                        <select asp-for="myProperty.Types_Of_Properties" class="form-select" id="typeOfProperty">
                            <option value="" selected disabled>Select Property</option>
                            <option value="Appartment">Appartment</option>
                            <option value="Villa">Villa</option>
                            <option value="Home">Home</option>
                            <option value="Office">Office</option>
                            <option value="Building">Building</option>
                            <option value="Townhouse">Townhouse</option>
                            <option value="Shope">Shope</option>
                            <option value="Garage">Garage</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="area" class="form-label">Area (sq ft)</label>
                        <input asp-for="myProperty.Area" class="form-control" id="area" placeholder="Enter area">
                    </div>
                    <div class="mb-3">
                        <label for="category" class="form-label">Category</label>                        
                        <select asp-for="myProperty.Category" class="form-select" id="propertyType">
                            <option>-------------------Select Your Category-----------------</option>
                            <option>Rent</option>
                            <option>Sale</option>
                            @*<option value="property-for-rent">Property-for-Rent</option>*@
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="bathrooms" class="form-label">Number of Baths</label>
                        <input asp-for="myProperty.Number_Of_Bathrooms" class="form-control" id="bathrooms" placeholder="Enter number of baths">
                    </div>
                    <div class="mb-3">
                        <label for="bedrooms" class="form-label">Number of Bedrooms</label>
                        <input asp-for="myProperty.Number_Of_Bedrooms" class="form-control" id="bedrooms" placeholder="Enter number of bedrooms">
                    </div>
                    <div class="mb-3">
                        <label for="Slug" class="form-label">Slug</label>
                        <input asp-for="myProperty.Slug" class="form-control" id="Slug" placeholder="Enter property Slug">
                    </div>
                    <div class="mb-3">
                        <label for="image" class="form-label">Upload a Front Facing Photo of property</label>
                        <input asp-for="myProperty.picture" class="form-control" id="image">
                    </div>
                    <center><button type="submit" class="btn btn-dark">Submit</button></center>
                </form>
            </div>

            <!--Rules-->
            <div class="col-md-6">
                    <div class="alert alert-success" role="alert">
                        <h4 class="alert-heading">Please read this before Registeration Form</h4>
                      
                            <ul>
                                <li class="text-danger"> Ensure all the information you provide is complete and accurate. Incorrect data may delay the approval process.</li>
                            </ul>
                            <ul>
                                <li class="text-danger">Before your property is approved and listed on the site, you will receive a confirmation call.</li>
                            </ul>
                            <ul>
                                <li class="text-danger">Your property will remain listed on the site for 30 days from the approval date.</li>
                            </ul>
                            <ul>
                               <li class="text-danger"> Please provide a valid WhatsApp number to facilitate communication and updates regarding your property.
                               </li>         </ul>
                    
                        <hr>
                        <p class="mb-0">Thanks</p>
                      </div>
                </div>
                
            </div>

    </div> 
<!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
