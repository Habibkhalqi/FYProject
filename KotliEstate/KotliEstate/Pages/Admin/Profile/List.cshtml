@page
@model KotliEstate.Pages.Admin.Profile.ListModel

@{
    ViewData["Title"] = "List";
}

<h1>List</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Profile[0].Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Profile[0].Address)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Profile[0].Phone)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Profile[0].Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Profile[0].Twitter)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Profile[0].Facebook)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Profile[0].Youtube)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Profile[0].LinkedIn)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Profile) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Address)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Phone)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Email)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Twitter)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Facebook)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Youtube)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.LinkedIn)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
